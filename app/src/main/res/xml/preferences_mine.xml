<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="false">

    <PreferenceCategory
        app:title="主题"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="setting_theme_color"
            app:title="主题配色"
            app:summary="选择主题颜色"
            app:defaultValue="teal"
            app:entries="@array/theme_color_entries"
            app:entryValues="@array/theme_color_values"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="外观"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="setting_app_icon"
            app:title="应用图标"
            app:summary="选择桌面图标样式"
            app:defaultValue="default"
            app:entries="@array/app_icon_entries"
            app:entryValues="@array/app_icon_values"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="日志"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_log_off"
            app:title="关闭日志"
            app:summary="关闭后不再记录运行日志"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_view_log"
            app:title="查看日志"
            app:summary="查看应用运行日志记录"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_clear_cache"
            app:title="清理缓存"
            app:summary="清理日志、搜索历史、地图缓存及残留安装包"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="定位设置"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="setting_altitude"
            app:title="海拔高度(米)"
            app:defaultValue="55.0"
            app:summary="55.0"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            app:key="setting_random_offset"
            app:title="随机偏移"
            app:summary="仅在使用历史位置时生效，默认开启"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lat_max_offset"
            app:title="经度最大偏移距离(米)"
            app:defaultValue="10.0"
            app:summary="10.0"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lon_max_offset"
            app:title="纬度最大偏移距离(米)"
            app:defaultValue="10.0"
            app:summary="10.0"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="关于"
        app:iconSpaceReserved="false">

        <Preference
            app:key="pref_feedback"
            app:title="问题反馈"
            app:summary="通过邮箱发送日志报告"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_update"
            app:title="检测更新"
            app:summary="检查是否有新版本"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_contact"
            app:title="联系作者"
            app:summary="shaua · 前往项目主页"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_dev"
            app:title="开发人员选项"
            app:summary="设置模拟位置应用"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

</PreferenceScreen>
