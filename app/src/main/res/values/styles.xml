<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="buttonStyle">@style/AppTheme.Button</item>
        <item name="buttonBarStyle">@style/Widget.AppCompat.ButtonBar.AlertDialog</item>
        <item name="buttonBarButtonStyle">@style/AppTheme.DialogButton</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 无 ActionBar 主题（欢迎页、主界面使用） -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 预设配色主题：青、蓝、紫、橙 -->
    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">@color/theme_teal_primary</item>
        <item name="colorPrimaryDark">@color/theme_teal_dark</item>
        <item name="colorAccent">@color/theme_teal_accent</item>
        <item name="android:statusBarColor">@color/theme_teal_dark</item>
        <item name="android:navigationBarColor">@color/theme_teal_dark</item>
    </style>

    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">@color/theme_blue_primary</item>
        <item name="colorPrimaryDark">@color/theme_blue_dark</item>
        <item name="colorAccent">@color/theme_blue_accent</item>
        <item name="android:statusBarColor">@color/theme_blue_dark</item>
        <item name="android:navigationBarColor">@color/theme_blue_dark</item>
    </style>

    <style name="AppTheme.Purple" parent="AppTheme">
        <item name="colorPrimary">@color/theme_purple_primary</item>
        <item name="colorPrimaryDark">@color/theme_purple_dark</item>
        <item name="colorAccent">@color/theme_purple_accent</item>
        <item name="android:statusBarColor">@color/theme_purple_dark</item>
        <item name="android:navigationBarColor">@color/theme_purple_dark</item>
    </style>

    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorPrimaryDark">@color/theme_orange_dark</item>
        <item name="colorAccent">@color/theme_orange_accent</item>
        <item name="android:statusBarColor">@color/theme_orange_dark</item>
        <item name="android:navigationBarColor">@color/theme_orange_dark</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- 点击波纹效果（白色背景上的灰色波纹） -->
    <style name="RippleWhite" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:colorControlHighlight">#C8C9CA</item>
        <item name="android:radius">14dp</item>
    </style>

    <!-- 对话框淡入淡出动画 -->
    <style name="DialogAnimFadeInFadeOut" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/anim_fade_in</item>
        <item name="android:windowExitAnimation">@anim/anim_fade_out</item>
    </style>

    <!-- 按钮样式 -->
    <style name="AppTheme.Button" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/colorAccent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- 对话框按钮样式：无边框，文字色随主题 -->
    <style name="AppTheme.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

</resources>
